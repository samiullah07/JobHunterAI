# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me

# ---- LLM (Groq free tier, OpenAI-compatible) ----
# Verify current model at console.groq.com/docs/models — swappable via env
GROQ_MODEL=llama-3.3-70b-versatile
LLM_DAILY_CALL_CAP=1000

# ---- Embeddings (local fastembed, no API key needed) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@localhost:5433/jobhunter

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Matching ----
MATCH_SCORE_THRESHOLD=0.75

# ---- Storage (local now; S3-compatible interface later) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Job boards / APIs (fill only what you use) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_TOKEN=
LEVER_TOKEN=

# ---- Notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Browser automation ----
BROWSER_HEADLESS=true
BROWSER_PROXY_URL=